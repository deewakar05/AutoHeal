# =============================================================================
# AutoHeal Environment Configuration Template
# Copy this file to .env to override defaults locally:
#   cp .env.example .env
#
# Never commit .env or store secrets/credentials in version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1: Web Application & Docker Infrastructure
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# -----------------------------------------------------------------------------
# Phase 2: Python Monitoring Engine & FastAPI Control Plane
# -----------------------------------------------------------------------------
API_PORT=8000
MONITOR_ENABLED=true
MONITOR_TARGET_URL=http://web/health
MONITOR_TARGET_SERVICE=web
MONITOR_INTERVAL=5
MONITOR_TIMEOUT=3
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
AUTOHEAL_DB_PATH=/data/autoheal.db
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Phase 3: Observability Stack (Prometheus, Alertmanager, Grafana)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ALERTMANAGER_CONFIG_FILE=./observability/alertmanager/alertmanager.yml
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Change GRAFANA_ADMIN_PASSWORD in your local .env before non-local use.
GRAFANA_ADMIN_PASSWORD=admin
