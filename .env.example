# =============================================================================
# AutoHeal Environment Configuration Template
# Copy this file to .env to override defaults locally:
#   cp .env.example .env
#
# Never commit .env or store secrets/credentials in version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Web Application & Docker Infrastructure
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080

# -----------------------------------------------------------------------------
# Python Monitoring Engine & FastAPI Control Plane
# -----------------------------------------------------------------------------
API_PORT=8000
MONITOR_ENABLED=true
MONITOR_TARGET_URL=http://web/health
MONITOR_TARGET_SERVICE=web
MONITOR_INTERVAL=5
MONITOR_TIMEOUT=3
MONITOR_FAILURE_THRESHOLD=3
MONITOR_RECOVERY_THRESHOLD=2
AUTOHEAL_DB_PATH=/data/autoheal.db
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Automated Remediation Engine (Safe Disabled & Dry-Run Defaults)
# -----------------------------------------------------------------------------
AUTOHEAL_REMEDIATION_ENABLED=false
AUTOHEAL_REMEDIATION_DRY_RUN=true
AUTOHEAL_REMEDIATION_COOLDOWN_SECONDS=300
AUTOHEAL_REMEDIATION_MAX_ATTEMPTS=3
AUTOHEAL_REMEDIATION_TIMEOUT_SECONDS=120
AUTOHEAL_REMEDIATION_STALE_TIMEOUT_SECONDS=180
AUTOHEAL_REMEDIATION_MAX_CONCURRENCY=1
AUTOHEAL_ALLOWED_SERVICES=web
AUTOHEAL_ALLOWED_ACTIONS=restart
AUTOHEAL_REMEDIATION_VERIFY_INTERVAL=5
AUTOHEAL_REMEDIATION_VERIFY_ATTEMPTS=6
AUTOHEAL_REMEDIATION_VERIFY_REQUIRED_SUCCESSES=2
AUTOHEAL_REMEDIATION_VERIFY_TARGET_URL=http://web/health
AUTOHEAL_REMEDIATION_EXECUTOR_POLL_INTERVAL=1
AUTOHEAL_REMEDIATION_DISPATCH_MODE=queue
AUTOHEAL_REMEDIATION_REQUIRE_ISOLATION=true
AUTOHEAL_REMEDIATION_ALLOWED_PROXY_HOST=docker-socket-proxy
AUTOHEAL_REMEDIATION_ALLOWED_PROXY_PORT=2375

# -----------------------------------------------------------------------------
# Nagios Core Monitoring & Authenticated Webhook Integration
# -----------------------------------------------------------------------------
NAGIOS_PORT=8081
NAGIOS_ADMIN_USER=nagiosadmin
# Change NAGIOS_ADMIN_PASSWORD and AUTOHEAL_NAGIOS_WEBHOOK_SECRET in .env before running (fail-closed if empty).
NAGIOS_ADMIN_PASSWORD=change-me-local-nagios-admin
AUTOHEAL_NAGIOS_WEBHOOK_SECRET=change-me-local-nagios-webhook-secret
AUTOHEAL_NAGIOS_ENABLED=true
NAGIOS_MONITOR_ENABLED=true
NAGIOS_STATUS_URL=http://nagios:8081/nagios4/cgi-bin/statusjson.cgi?query=programstatus
NAGIOS_PROBE_TIMEOUT=3
AUTOHEAL_NAGIOS_SERVICE_MAP=
